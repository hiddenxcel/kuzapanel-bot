# Copy this file to config/.env and fill in real values. Never commit config/.env

# --- Database (MySQL) ---
DB_HOST=localhost
DB_NAME=kuzapanel_bot
DB_USER=root
DB_PASS=

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_NUMBER=

# --- Admin (owner WhatsApp number, for restricted bot commands) ---
ADMIN_PHONE_NUMBER=

# --- Links ---
KUZAPANEL_GROUP_URL=#
KUZAPANEL_WEBSITE_URL=#

# --- Referral (bonus % to referrer on referred customer's first deposit) ---
REFERRAL_PERCENT=10

# --- Payment gateways ---
ZENOPAY_API_KEY=
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
HARAKAPAY_API_KEY=

# --- App ---
APP_ENV=local
APP_URL=http://localhost/kuzapanel/bot/public
# Timezone for all timestamps (PHP + MySQL). Leave as-is for Tanzania.
APP_TIMEZONE=Africa/Dar_es_Salaam
